# Neuralwire backend configuration (copy to .env or export in your shell)

# HTTP listen port
PORT=8080

# Runtime environment: development (default) or production. In production the
# server refuses to boot with default admin credentials or the development
# ADMIN_TOKEN_SECRET.
APP_ENV=development

# SQLite database path (relative to the backend/ directory)
DB_PATH=data/neuralwire.db

# User-Agent sent with every outbound RSS/scrape request. The default marks
# the bot as a development build; replace with a real bot UA + your domain
# before going public, e.g.:
# USER_AGENT=NeuralwireBot/1.0 (+https://neuralwire.com)
USER_AGENT=Mozilla/5.0 (compatible; NeuralwireBot/1.0-dev; +https://neuralwire.example)

# Allowed frontend origins (comma-separated)
CORS_ALLOW_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# --- Admin API auth ------------------------------------------------------
# Credentials for POST /api/admin/login. CHANGE THESE outside local
# development. Every other /api/admin/* route requires the returned
# Authorization: Bearer <token> header.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# Secret used to sign admin bearer tokens (HMAC-SHA256). Change it outside
# development; tokens issued with the old secret stop validating.
ADMIN_TOKEN_SECRET=neuralwire-dev-secret-7f3c9a1e4b8d2f6a

# --- AI Summaries ------------------------------------------------------
# AI summary is OPTIONAL. Without a key the backend falls back to a plain
# 300-character excerpt of each article.
#
# 1) Choose a provider preset (openai | gemini | openrouter | groq | ollama)
#    and set AI_SUMMARY_API_KEY accordingly. Presets fill in sensible
#    defaults for AI_SUMMARY_BASE_URL and AI_SUMMARY_MODEL.
# 2) To override, set AI_SUMMARY_BASE_URL and/or AI_SUMMARY_MODEL explicitly
#    (they always win over the preset).
#
# Provider quick reference:
#   openai    -> https://platform.openai.com/api-keys          (sk-...)
#   gemini    -> https://aistudio.google.com/apikey            (AIza...)
#   openrouter-> https://openrouter.ai/keys                    (sk-or-...)
#   groq      -> https://console.groq.com/keys                 (gsk_...)
#   ollama    -> local server, no key required                 (llama3.2)
AI_SUMMARY_PROVIDER=openai
AI_SUMMARY_API_KEY=
AI_SUMMARY_MODEL=gpt-4o-mini
AI_SUMMARY_BASE_URL=https://api.openai.com/v1
# AI cover-image generation (DALL-E style /images/generations). Auto-detected
# from the provider/base URL: enabled for OpenAI, disabled for text-only
# providers (DeepSeek, Ollama, Gemini, Groq, OpenRouter). Override manually:
# AI_IMAGE_GENERATION_ENABLED=true|false

# RSS ingestion is MANUAL: there is no background scheduler. Trigger one
# fetch cycle with an authenticated admin request:
#   POST /api/admin/fetch  (Authorization: Bearer <token>)
# The response reports per-source and aggregate stats.
#
# Full-content scraping: RSS feeds only carry short excerpts, so the fetcher
# scrapes the article URL for its full readable body. These limit how many
# newest articles per source are scraped per cycle and how long each scrape
# may take. Items that are not scraped fall back to the RSS excerpt.
SCRAPE_MAX_PER_SOURCE=5
# Hard cap on how many new articles per source are stored as drafts in one
# fetch cycle (scraped or fallback alike). Use to bound the total draft
# volume regardless of RSS excerpt length.
SCRAPE_MAX_INSERT_PER_SOURCE=5
SCRAPE_TIMEOUT_SECONDS=15
# Politeness delay between external requests (RSS feed fetches and article
# scrapes). A random delay in [min, max] seconds is applied before each
# request so upstream sites see at most one request every 1-2 seconds.
SCRAPE_DELAY_MIN_SECONDS=1
SCRAPE_DELAY_MAX_SECONDS=2
# Minimum content length for a fetched article to be kept as a draft.
# Articles whose content is shorter (scrape failed or budget exhausted) are
# skipped as low quality instead of being stored.
SCRAPE_MIN_CONTENT_CHARS=500

# Per-IP rate limit for POST /api/news/{id}/view (views per minute).
# <=0 disables the limiter.
VIEW_RATE_LIMIT=30

# Cache TTL (seconds) for trending results to avoid re-aggregating the full
# view log on every request. <=0 disables trending caching.
TRENDING_CACHE_TTL_SECONDS=300
