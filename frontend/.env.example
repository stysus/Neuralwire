# Backend API base URL used by the frontend at runtime.

# PRODUCTION: leave PUBLIC_API_URL UNSET (or empty). The frontend is served by
# the Go backend on the same origin, so the API is reached via the relative
# path "/api". Do NOT hardcode a host in production — a wrong host would make
# visitors' browsers call their own localhost.

# DEVELOPMENT: the Vite dev server runs on :5173 while the backend is on
# :8080, so relative "/api" does not work. Set it in a local .env.local:
#   PUBLIC_API_URL=http://localhost:8080/api
# (Copy this into frontend/.env.local — .env.local is gitignored.)

# Public origin of the frontend (used for canonical/OG URLs at runtime).
# sitemap.xml and robots.txt are generated dynamically by the Go backend.
# PUBLIC_SITE_URL=https://example.com
